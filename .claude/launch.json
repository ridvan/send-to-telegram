{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "extension",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "extension",
        "dev:pages"
      ],
      "port": 3002
    },
    {
      "name": "extension-fake-relay",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WXT_RELAY_URL=https://relay.invalid",
        "pnpm",
        "--filter",
        "extension",
        "dev:pages"
      ],
      "port": 3002
    },
    {
      "name": "extension-pages",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3001",
        "--directory",
        "packages/extension/.output/chrome-mv3-pages"
      ],
      "port": 3001
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "site",
        "dev"
      ],
      "port": 3003
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "site",
        "preview",
        "--port",
        "3004"
      ],
      "port": 3004
    }
  ]
}
