{
  "name": "send-to-telegram",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "author": "Rıdvan Aktogan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ridvan/send-to-telegram.git"
  },
  "scripts": {
    "dev": "pnpm --filter extension dev",
    "dev:firefox": "pnpm --filter extension dev:firefox",
    "dev:relay": "pnpm --filter relay dev",
    "build": "pnpm --filter extension build && pnpm --filter extension build:firefox",
    "zip": "pnpm --filter extension zip && pnpm --filter extension zip:firefox",
    "deploy:relay": "pnpm --filter relay run deploy",
    "lint": "oxlint . --max-warnings 0",
    "lint:fix": "oxlint . --fix --max-warnings 0",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@shadcn/lint": "^0.2.3",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "typescript": "^7.0.2"
  }
}
