{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "send-to-telegram-relay",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-20",
    // Console logs only. Invocation logs are off because they record request
    // metadata, and requests carry device tokens.
    "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false },
    },
    // The hosted relay's address; the extension saves it with each linked chat,
    // so it must not change. Forks: use a domain on your own Cloudflare zone.
    "routes": [{ "pattern": "relay.s2t.dev", "custom_domain": true }],
    // Only the custom domain: workers.dev and preview URLs sit outside the
    // zone, so its WAF and rate limiting rules wouldn't cover them.
    "workers_dev": false,
    "preview_urls": false,
    "vars": {
        // The bot's username without the @, as BotFather shows it.
        "BOT_USERNAME": "S2TRelayBot",
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "send-to-telegram",
            // No database_id: the first `wrangler deploy` creates the database,
            // later deploys reuse the one bound to the deployed Worker, and D1
            // commands find it by name. Don't commit the id Wrangler writes
            // back here on that first deploy.
            "migrations_dir": "migrations",
        },
    ],
    "ratelimits": [
        {
            // Per linked browser.
            "name": "SEND_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 30, "period": 60 },
        },
        {
            // Per IP address, for new pairing links.
            "name": "PAIR_LIMITER",
            "namespace_id": "1002",
            "simple": { "limit": 10, "period": 60 },
        },
        {
            // Per chat, Telegram's own limit for groups, so many linked
            // browsers can't flood one chat or the bot's global limit.
            "name": "CHAT_LIMITER",
            "namespace_id": "1003",
            "simple": { "limit": 20, "period": 60 },
        },
        {
            // Per chat, for bot commands; over the limit they're ignored.
            "name": "COMMAND_LIMITER",
            "namespace_id": "1004",
            "simple": { "limit": 10, "period": 60 },
        },
    ],
    // Daily cleanup of pairing links nobody used.
    "triggers": { "crons": ["17 3 * * *"] },
}
